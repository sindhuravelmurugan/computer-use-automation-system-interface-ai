# Copy to .env and fill in the key for whichever provider you use.
#
# Only `discover` needs a key. `replay`, `capabilities`, `show`, and `operator`
# never call an LLM (CLAUDE.md invariant 1) and run fine with this file absent
# or empty.

# Which provider `discover` uses by default: "gemini" or "anthropic".
# Overridable per-run with `--provider`.
LLM_PROVIDER=gemini

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a key at https://console.anthropic.com/settings/keys
# Only required if LLM_PROVIDER=anthropic (or --provider anthropic).
ANTHROPIC_API_KEY=
